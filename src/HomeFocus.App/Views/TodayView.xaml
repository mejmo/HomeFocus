<UserControl x:Class="HomeFocus.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HomeFocus.App.Localization"
             xmlns:c="clr-namespace:HomeFocus.App.Controls">
    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Muted}"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Button.Icon}" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Card}"
                        Command="{Binding PrevDayCommand}" ToolTip="{l:T today.prev}" AutomationProperties.Name="{l:T today.prev}">
                    <c:IconView Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16"/>
                </Button>
                <Button Content="{l:T today.goToday}" Margin="8,0" Command="{Binding GoTodayCommand}"/>
                <Button Style="{StaticResource Button.Icon}" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Card}"
                        Command="{Binding NextDayCommand}" IsEnabled="{Binding CanGoNext}" ToolTip="{l:T today.next}" AutomationProperties.Name="{l:T today.next}">
                    <c:IconView Data="{StaticResource Icon.ChevronRight}" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Offer the browser extension while no browser is paired -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="18,14"
                Visibility="{Binding ShowWebBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="32" Height="32" Margin="8,0,0,0"
                        Command="{Binding DismissWebBannerCommand}" ToolTip="{l:T web.dismiss}" AutomationProperties.Name="{l:T web.dismiss}">
                    <c:IconView Data="{StaticResource Icon.Close}" Width="14" Height="14"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{l:T web.enable}"
                        Command="{Binding EnableWebTrackingCommand}" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{l:T web.bannerTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{l:T web.bannerText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- KPI tiles -->
        <UniformGrid Columns="4" Margin="-8,0,-8,20">
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{l:T today.active}" Style="{StaticResource Text.Caps}"/>
                    <TextBlock Text="{Binding ActiveText}" Style="{StaticResource Text.Value}" Margin="0,8,0,2"/>
                    <TextBlock Text="{Binding ActiveSub}" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding TopCategoryBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T today.topCategory}" Style="{StaticResource Text.Caps}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TopCategoryText}" Style="{StaticResource Text.Value}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TopCategorySub}" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{l:T today.idle}" Style="{StaticResource Text.Caps}"/>
                    <TextBlock Text="{Binding IdleText}" Style="{StaticResource Text.Value}" Margin="0,8,0,2"/>
                    <TextBlock Text="{Binding IdleSub}" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{l:T today.topApp}" Style="{StaticResource Text.Caps}"/>
                    <TextBlock Text="{Binding TopAppText}" Style="{StaticResource Text.Value}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TopAppSub}" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Timeline -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <DockPanel Margin="0,0,0,18">
                    <TextBlock Text="{l:T today.timeline}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding Legend}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <c:TimelineBar Items="{Binding Timeline}" StartHour="{Binding TimelineStart}" NowHour="{Binding NowHour}"/>
            </StackPanel>
        </Border>

        <!-- Apps + categories -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T today.topApps}" Style="{StaticResource Text.H2}" Margin="0,0,0,16"/>
                    <TextBlock Text="{l:T today.empty}"
                               Style="{StaticResource Text.Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{Binding Tint}">
                                        <TextBlock Text="{Binding Initial}" Foreground="{Binding TextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding AppKey}"/>
                                            <TextBlock Text="{l:T rules.kindWeb}" Foreground="{DynamicResource Brush.Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsWeb, Converter={StaticResource BoolToVis}}"/>
                                            <Border Style="{StaticResource Chip}" Background="{Binding Tint}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Category}" Foreground="{Binding TextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource Progress.Thin}" Value="{Binding Fraction, Mode=OneWay}" Foreground="{Binding Brush}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T today.categories}" Style="{StaticResource Text.H2}" Margin="0,0,0,16"/>
                    <c:ProportionBar Items="{Binding Shares}" Margin="0,0,0,18"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Percent}" Foreground="{DynamicResource Brush.Muted}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Time}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
