<UserControl x:Class="HomeFocus.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HomeFocus.App.Localization"
             xmlns:c="clr-namespace:HomeFocus.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Caps}">
            <Setter Property="Margin" Value="4,0,0,10"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Item" TargetType="Border">
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="ItemLast" TargetType="Border" BasedOn="{StaticResource Item}">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="ItemTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
        <TextBlock Text="{l:T settings.title}" Style="{StaticResource Text.H1}" Margin="0,18,0,24"/>

        <TextBlock Text="{l:T settings.tracking}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,4" Margin="0,0,0,24">
            <StackPanel>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding IdleOptions}" SelectedItem="{Binding Idle}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="{l:T settings.idle}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.idle}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T settings.idleText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ItemLast}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{l:T settings.extGet}" Command="{Binding GetExtensionCommand}" Margin="16,0,0,0"
                                    Style="{StaticResource Button.Primary}"
                                    Visibility="{Binding ShowEnableWeb, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{l:T settings.extDisconnect}" Command="{Binding DisconnectBrowsersCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource Button.Danger}" Visibility="{Binding HasPairedBrowsers, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.ext}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{Binding ExtensionStatus}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                            <TextBlock Text="{l:T settings.extText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="{l:T ai.section}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,4" Margin="0,0,0,24">
            <StackPanel>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding AiEnabled}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{l:T ai.enable}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T ai.enable}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T ai.enableText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Right" Width="300" Text="{Binding AiPosition, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                                 Tag="{l:T ai.positionHint}" AutomationProperties.Name="{l:T ai.position}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:T ai.position}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T ai.positionText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="220" Text="{Binding AiUrl, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                                     AutomationProperties.Name="{l:T ai.server}"/>
                            <Button Content="{l:T ai.connect}" Command="{Binding AiConnectCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:T ai.server}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T ai.serverText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                            <TextBlock Text="{l:T ai.remoteWarning}" Foreground="{DynamicResource Brush.WarnText}" FontSize="12.5" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding AiRemoteWarning, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ItemLast}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox Width="220" ItemsSource="{Binding AiModels}" SelectedItem="{Binding AiModel}" Tag="{l:T ai.pickModel}"
                                      AutomationProperties.Name="{l:T ai.model}"/>
                            <Button Content="{l:T ai.runNow}" Command="{Binding AiRunNowCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:T ai.model}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{Binding AiStatus}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="{l:T settings.system}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,4" Margin="0,0,0,24">
            <StackPanel>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Autostart}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{l:T settings.autostartName}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.autostart}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T settings.autostartText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{l:T settings.closeToTrayName}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.closeToTray}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T settings.closeToTrayText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ItemLast}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="{l:T settings.theme}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.theme}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T settings.themeText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="{l:T settings.data}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,4">
            <StackPanel>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Folder}" Width="15" Height="15" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T common.openFolder}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.database}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{Binding DbPath}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DbInfo}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ExportAllCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Download}" Width="15" Height="15" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T settings.exportButton}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.export}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T settings.exportText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ItemLast}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}" Content="{l:T settings.clearButton}" Command="{Binding DeleteHistoryCommand}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.clear}" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{l:T settings.clearText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
