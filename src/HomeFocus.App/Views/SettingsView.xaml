<UserControl x:Class="HomeFocus.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeFocus.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Caps}">
            <Setter Property="Margin" Value="4,0,0,10"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Item" TargetType="Border">
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="ItemLast" TargetType="Border" BasedOn="{StaticResource Item}">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="ItemTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
        <TextBlock Text="Nastavenia" Style="{StaticResource Text.H1}" Margin="0,18,0,24"/>

        <TextBlock Text="SLEDOVANIE" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,4" Margin="0,0,0,24">
            <StackPanel>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding IdleOptions}" SelectedItem="{Binding Idle}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="Prah nečinnosti"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Prah nečinnosti" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Keď sa myš ani klávesnica nepohnú dlhšie, čas sa prestane počítať." Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ItemLast}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Padding="10,4">
                            <TextBlock Text="Pripravujeme" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Weby a mobil" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Sledovanie webov cez rozšírenie prehliadača a štatistiky z Androidu pribudnú v ďalšej verzii." Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="SYSTÉM" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,4" Margin="0,0,0,24">
            <StackPanel>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Autostart}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Spustiť pri prihlásení"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Spustiť pri prihlásení do Windows" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="HomeFocus sa spustí potichu v oblasti oznámení." Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Zavrieť do oblasti oznámení"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Zavretie okna ho len skryje" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Sledovanie beží ďalej, aplikáciu ukončíš z ikony v oblasti oznámení." Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ItemLast}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="Vzhľad"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Vzhľad" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Svetlý, tmavý alebo podľa nastavenia Windows." Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="DÁTA" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,4">
            <StackPanel>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Folder}" Width="15" Height="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Otvoriť priečinok"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Databáza" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="{Binding DbPath}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DbInfo}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Item}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ExportAllCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Download}" Width="15" Height="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Exportovať CSV"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Export" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Celá história ako CSV (otvoríš v Exceli)." Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ItemLast}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}" Content="Vymazať…" Command="{Binding DeleteHistoryCommand}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Vymazať históriu" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Kategórie, pravidlá a nastavenia zostanú." Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
