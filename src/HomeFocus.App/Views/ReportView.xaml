<UserControl x:Class="HomeFocus.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HomeFocus.App.Localization"
             xmlns:c="clr-namespace:HomeFocus.App.Controls">
    <StackPanel>
        <!-- Header -->
        <DockPanel Margin="0,0,0,20" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding RangeText}" Style="{StaticResource Text.Muted}"/>
                <TextBlock Text="{l:T report.title}" Style="{StaticResource Text.H1}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border Style="{StaticResource Segmented}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T report.week}" IsChecked="{Binding IsWeek}" GroupName="range"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T report.month}" IsChecked="{Binding IsMonth}" GroupName="range"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Button.Icon}" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Card}"
                        Margin="12,0,0,0" Command="{Binding PrevCommand}" ToolTip="{l:T report.prev}" AutomationProperties.Name="{l:T report.prev}">
                    <c:IconView Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource Button.Icon}" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Card}"
                        Margin="8,0,0,0" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" ToolTip="{l:T report.next}" AutomationProperties.Name="{l:T report.next}">
                    <c:IconView Data="{StaticResource Icon.ChevronRight}" Width="16" Height="16"/>
                </Button>
                <ComboBox Width="190" Margin="12,0,0,0" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{l:T common.category}"/>
                <Button Margin="12,0,0,0" Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Data="{StaticResource Icon.Download}" Width="15" Height="15" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T common.exportCsv}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- KPIs -->
        <UniformGrid Columns="4" Margin="-8,0,-8,20">
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{l:T report.total}" Style="{StaticResource Text.Caps}"/>
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource Text.Value}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{l:T report.avg}" Style="{StaticResource Text.Caps}"/>
                    <TextBlock Text="{Binding AvgText}" Style="{StaticResource Text.Value}" Margin="0,8,0,0"/>
                    <TextBlock Text="{l:T report.avgSub}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{l:T report.best}" Style="{StaticResource Text.Caps}"/>
                    <TextBlock Text="{Binding BestText}" Style="{StaticResource Text.Value}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding BestSub}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="{l:T report.apps}" Style="{StaticResource Text.Caps}"/>
                    <TextBlock Text="{Binding AppCountText}" Style="{StaticResource Text.Value}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Chart -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <DockPanel Margin="0,0,0,18">
                    <TextBlock Text="{l:T report.byCategory}" Style="{StaticResource Text.H2}"/>
                    <ItemsControl ItemsSource="{Binding Legend}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <c:StackedBarChart Items="{Binding Bars}"/>
            </StackPanel>
        </Border>

        <!-- Ranking + share -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T report.ranking}" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource Text.Caps}"/>
                        <TextBlock Grid.Column="1" Text="{l:T report.colApp}" Style="{StaticResource Text.Caps}"/>
                        <TextBlock Grid.Column="2" Text="{l:T report.colCategory}" Style="{StaticResource Text.Caps}"/>
                        <TextBlock Grid.Column="3" Text="{l:T report.colTime}" Style="{StaticResource Text.Caps}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{l:T report.colShare}" Style="{StaticResource Text.Caps}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,4"/>
                    <TextBlock Text="{l:T report.empty}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource Brush.Muted}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding AppKey}"/>
                                            <TextBlock Text="{l:T rules.kindWeb}" Foreground="{DynamicResource Brush.Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsWeb, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Time}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Share}" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{l:T report.share}" Style="{StaticResource Text.H2}" Margin="0,0,0,16"/>
                    <c:ProportionBar Items="{Binding Shares}" Height="14" Margin="0,0,0,18"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Percent}" Foreground="{DynamicResource Brush.Muted}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Time}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
