<Window x:Class="HomeFocus.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="460" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.UI}" FontSize="13.5" Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" Title="HomeFocus">
    <Border Margin="20" Padding="24" CornerRadius="14" BorderThickness="1"
            Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" Effect="{StaticResource Shadow.Popup}">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" FontSize="17" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,22" LineHeight="20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" Click="Secondary_Click" IsCancel="True" MinWidth="90"/>
                <Button x:Name="PrimaryButton" Click="Primary_Click" IsDefault="True" MinWidth="90" Margin="10,0,0,0" Style="{StaticResource Button.Primary}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
