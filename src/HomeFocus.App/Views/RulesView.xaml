<UserControl x:Class="HomeFocus.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HomeFocus.App.Localization"
             xmlns:c="clr-namespace:HomeFocus.App.Controls"
             x:Name="Self">
    <UserControl.Resources>
        <!-- Category choice: color dot + name -->
        <DataTemplate x:Key="CategoryChoice">
            <StackPanel Orientation="Horizontal">
                <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="CatRow" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,0" Height="40" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{l:T rules.subtitle}" Style="{StaticResource Text.Muted}"/>
            <TextBlock Text="{l:T rules.title}" Style="{StaticResource Text.H1}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Uncategorized apps -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding Uncategorized.Count, Converter={StaticResource CountToVis}}"
                BorderBrush="{DynamicResource Brush.Warn}">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="{l:T rules.uncategorized}" Style="{StaticResource Text.H2}"/>
                    <TextBlock Text="{l:T rules.uncategorizedHint}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Uncategorized}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,10" Padding="14,8,8,8" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Subtle}">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding Choices}" SelectedItem="{Binding Category}" Tag="{l:T rules.assign}"
                                              ItemTemplate="{StaticResource CategoryChoice}" AutomationProperties.Name="{l:T common.category}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12">
                                            <Run Text="{Binding AppKey, Mode=OneWay}"/> · <Run Text="{Binding Time, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border Style="{StaticResource Card}" Padding="12" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="8,4,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="32" Height="32" Command="{Binding StartAddCategoryCommand}"
                                ToolTip="{l:T rules.addCategory}" AutomationProperties.Name="{l:T rules.addCategory}">
                            <c:IconView Data="{StaticResource Icon.Plus}" Width="16" Height="16"/>
                        </Button>
                        <TextBlock Text="{l:T rules.categories}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding CategoryRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource CatRow}" IsChecked="{Binding IsSelected}" GroupName="cats">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="28" Height="28" Margin="6,0,-6,0"
                                                Command="{Binding DeleteCommand}" ToolTip="{l:T rules.deleteCategory}" AutomationProperties.Name="{l:T rules.deleteCategory}"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}">
                                            <c:IconView Data="{StaticResource Icon.Trash}" Width="14" Height="14"/>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Brush.Muted}" FontSize="12" VerticalAlignment="Center"/>
                                        <Border Width="12" Height="12" CornerRadius="4" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </DockPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add category -->
                    <Border Margin="0,10,0,0" Padding="12" CornerRadius="10" Background="{DynamicResource Brush.Subtle}"
                            Visibility="{Binding IsAddingCategory, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T rules.categoryName}"
                                     AutomationProperties.Name="{l:T rules.categoryName}"/>
                            <ItemsControl ItemsSource="{Binding Colors}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0" MinHeight="0"
                                                Command="{Binding DataContext.PickColorCommand, ElementName=Self}" CommandParameter="{Binding}"
                                                Background="{Binding Converter={StaticResource HexToBrush}}" BorderThickness="0"
                                                AutomationProperties.Name="{Binding}">
                                            <c:IconView Data="{StaticResource Icon.Check}" Width="14" Height="14" Foreground="White" StrokeThickness="3">
                                                <c:IconView.Visibility>
                                                    <MultiBinding Converter="{StaticResource EqualsToVis}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.NewCategoryColor" ElementName="Self"/>
                                                    </MultiBinding>
                                                </c:IconView.Visibility>
                                            </c:IconView>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource Button.Primary}" Content="{l:T common.add}" Command="{Binding AddCategoryCommand}"/>
                                <Button Style="{StaticResource Button.Ghost}" Content="{l:T common.cancel}" Margin="8,0,0,0" Command="{Binding CancelAddCategoryCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Rules -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBox DockPanel.Dock="Right" Width="240" Tag="{l:T rules.search}"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T rules.searchName}"/>
                        <TextBlock Text="{Binding RulesTitle}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- New rule -->
                    <Border Padding="12" CornerRadius="10" Background="{DynamicResource Brush.Subtle}" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding AddRuleCommand}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Data="{StaticResource Icon.Plus}" Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="{l:T rules.addRule}"/>
                                </StackPanel>
                            </Button>
                            <ComboBox DockPanel.Dock="Right" Width="180" Margin="10,0,0,0" ItemsSource="{Binding Choices}" SelectedItem="{Binding NewPatternCategory}"
                                      ItemTemplate="{StaticResource CategoryChoice}" AutomationProperties.Name="{l:T rules.newRuleCategory}"/>
                            <TextBox Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T rules.patternHint}"
                                     AutomationProperties.Name="{l:T rules.pattern}"/>
                        </DockPanel>
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T rules.colPattern}" Style="{StaticResource Text.Caps}"/>
                        <TextBlock Grid.Column="1" Text="{l:T rules.colCategory}" Style="{StaticResource Text.Caps}"/>
                        <TextBlock Grid.Column="2" Text="{l:T rules.colSource}" Style="{StaticResource Text.Caps}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                    <!-- ~100 rows: each row has a light category button; one shared menu is built only when it is clicked. -->
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Brush.Subtle}" CornerRadius="5" Padding="7,3">
                                                <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
                                            </Border>
                                            <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource Brush.Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="0,0,16,0" HorizontalContentAlignment="Stretch" Padding="12,0,10,0"
                                                Background="{DynamicResource Brush.Input}" Click="CategoryButton_Click"
                                                AutomationProperties.Name="{l:T common.category}">
                                            <DockPanel>
                                                <c:IconView DockPanel.Dock="Right" Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14"
                                                            Foreground="{DynamicResource Brush.Muted}"/>
                                                <ContentPresenter Content="{Binding Category}" ContentTemplate="{StaticResource CategoryChoice}"
                                                                  HorizontalAlignment="Left"/>
                                            </DockPanel>
                                        </Button>
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{DynamicResource Brush.Muted}"/>
                                        </Border>
                                        <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Command="{Binding DeleteCommand}"
                                                ToolTip="{l:T rules.deleteRule}" AutomationProperties.Name="{l:T rules.deleteRule}">
                                            <c:IconView Data="{StaticResource Icon.Trash}" Width="15" Height="15"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,14,0,0"
                               Text="{l:T rules.footer}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
