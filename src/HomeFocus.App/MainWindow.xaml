<Window x:Class="HomeFocus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeFocus.App.ViewModels"
        xmlns:v="clr-namespace:HomeFocus.App.Views"
        xmlns:c="clr-namespace:HomeFocus.App.Controls"
        Title="HomeFocus" Width="1280" Height="840" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TodayViewModel}"><v:TodayView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}"><v:ReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}"><v:RulesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,14,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,24">
                    <Image Source="pack://application:,,,/Assets/icon-256.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="HomeFocus" FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status / pause card -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Subtle}" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Ok}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warn}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NowText}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,0,10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <Button x:Name="PauseButton" HorizontalContentAlignment="Center" Click="PauseButton_Click" AutomationProperties.Name="Pozastaviť sledovanie"
                                Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Pause}" Width="15" Height="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Pozastaviť"/>
                                <c:IconView Data="{StaticResource Icon.ChevronDown}" Width="13" Height="13" Margin="6,1,0,0" Foreground="{DynamicResource Brush.Muted}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Na 15 minút" Command="{Binding PauseCommand}" CommandParameter="15"/>
                                    <MenuItem Header="Na 30 minút" Command="{Binding PauseCommand}" CommandParameter="30"/>
                                    <MenuItem Header="Na 1 hodinu" Command="{Binding PauseCommand}" CommandParameter="60"/>
                                    <MenuItem Header="Na 2 hodiny" Command="{Binding PauseCommand}" CommandParameter="120"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ResumeCommand}" AutomationProperties.Name="Pokračovať v sledovaní"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Play}" Width="14" Height="14" Margin="0,0,8,0" Filled="True" StrokeThickness="1.5"/>
                                <TextBlock Text="Pokračovať"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource Nav}" Tag="{StaticResource Icon.Today}" Content="Dnes" IsChecked="{Binding IsToday}" GroupName="nav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="{StaticResource Icon.Report}" Content="Prehľad" IsChecked="{Binding IsReport}" GroupName="nav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="{StaticResource Icon.Rules}" Content="Kategórie a pravidlá" IsChecked="{Binding IsRules}" GroupName="nav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="{StaticResource Icon.Settings}" Content="Nastavenia" IsChecked="{Binding IsSettings}" GroupName="nav"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl Content="{Binding Current}" Margin="32,44,32,32" Focusable="False"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Caption}" Click="Minimize_Click" ToolTip="Minimalizovať">
                    <c:IconView Data="{StaticResource Icon.Minimize}" Width="14" Height="14" StrokeThickness="1.5"/>
                </Button>
                <Button Style="{StaticResource Button.Caption}" Click="Maximize_Click" ToolTip="Maximalizovať">
                    <c:IconView x:Name="MaxIcon" Data="{StaticResource Icon.Maximize}" Width="13" Height="13" StrokeThickness="1.5"/>
                </Button>
                <Button Style="{StaticResource Button.CaptionClose}" Click="Close_Click" ToolTip="Zavrieť">
                    <c:IconView Data="{StaticResource Icon.Close}" Width="14" Height="14" StrokeThickness="1.5"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
