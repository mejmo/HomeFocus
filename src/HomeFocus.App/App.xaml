<Application x:Class="HomeFocus.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HomeFocus.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- index 0 is swapped by ThemeManager -->
                <ResourceDictionary Source="/Themes/Light.xaml"/>
                <ResourceDictionary Source="/Themes/Icons.xaml"/>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <c:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
            <c:CountToVisibilityConverter x:Key="CountToVis"/>
            <c:HexToBrushConverter x:Key="HexToBrush"/>
            <c:EqualsToVisibilityConverter x:Key="EqualsToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
